# Backend Centralized API Base URL (Must be full URL, e.g., http://localhost:5000/api in local dev or https://api.yourdomain.com/api in prod)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Canonical Site URL (for SEO, sitemaps, robots.txt, and OpenGraph tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense / Ads Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADS_CLIENT_ID=ca-pub-0000000000000000
