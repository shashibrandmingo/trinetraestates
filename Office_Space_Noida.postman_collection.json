              "raw": "{\n  \"title\": \"Premium Furnished Office Sector 62\",\n  \"slug\": \"premium-furnished-office-sector-62-test\",\n  \"propertyType\": \"Office\",\n  \"purpose\": \"Rent\",\n  \"description\": \"Fully furnished prime workspace with dedicated meeting rooms.\",\n  \"location\": {\n    \"city\": \"Noida\",\n    \"sector\": \"Sector 62\",\n    \"locality\": \"Electronic City\",\n    \"address\": \"Plot No 4, Sector 62, Noida\"\n  },\n  \"buildingName\": \"Logix Cyber Park\",\n  \"floor\": \"4th Floor\",\n  \"areaSqFt\": 2500,\n  \"carpetAreaSqFt\": 2100,\n  \"furnishing\": \"Fully-Furnished\",\n  \"seats\": 35,\n  \"cabins\": 3,\n  \"meetingRooms\": 1,\n  \"parkingSlots\": 4,\n  \"pricing\": {\n    \"expectedPrice\": 150000,\n    \"isNegotiable\": true,\n    \"securityDeposit\": 300000\n  },\n  \"status\": \"Available\",\n  \"ownerContact\": {\n    \"name\": \"Test Owner\",\n    \"phone\": \"+919876543210\",\n    \"email\": \"owner@example.com\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/offices",
              "host": ["{{baseUrl}}"],
              "path": ["offices"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Office created successfully (201 or 400)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
